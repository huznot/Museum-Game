  m_GameObject: {fileID: 1699600241}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f1214fb30866644fb811b04fa59a1f2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InfoOpener
  interactRange: 1.5
  popupController: {fileID: 7154850324694818045}
  titleText: {fileID: 568867888}
  infoText: {fileID: 1737973553}
  titleContent: Great Empires
  infoContent: Africa was home to some of the most powerful civilisations the world
    has ever seen. The Mali Empire under Mansa Musa was the wealthiest nation on
    earth. The Kingdom of Kush built more pyramids than Egypt. Timbuktu held one
    of the world's first universities with over 25,000 students. These were not small
    communities. They were empires with armies, scholars, and global trade networks.
