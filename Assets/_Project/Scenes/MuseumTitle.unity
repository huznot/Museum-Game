  m_Script: {fileID: 11500000, guid: 5f1214fb30866644fb811b04fa59a1f2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InfoOpener
  interactRange: 1.5
  popupController: {fileID: 7154850324694818045}
  titleText: {fileID: 568867888}
  infoText: {fileID: 1737973553}
  titleContent: 'Architecture & Cities '
  infoContent: "Long before European colonisation, African cities were centres of
    culture, commerce, and learning. Great Zimbabwe was a stone city housing over
    18,000 people, built entirely without mortar. The Great Mosque of Djenn\xE9 in
    Mali is the largest mud brick structure on earth and has stood for over 700 years.
    Timbuktu drew traders and scholars from across the world throughout the 14th
    and 15th centuries."
